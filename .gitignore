# Local .terraform directories
**/.terraform/*

# .tfstate files (contain unencrypted secrets)
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Secret / environment variable files
*.tfvars
*.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc
